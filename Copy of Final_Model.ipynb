# ============================================
# CELL 17: 5-FOLD CROSS-VALIDATION TRAINING
# ============================================

from sklearn.metrics import (
    accuracy_score,
    balanced_accuracy_score,
    recall_score,
    f1_score,
    confusion_matrix
)

MAX_EPOCHS_CV = 100
PATIENCE_CV = 15
BATCH_SIZE_CV = 2

fold_results = []
oof_predictions = np.full(len(patient_records), -1)
oof_probabilities = np.zeros((len(patient_records), 2))

for fold_number, (train_idx, val_idx) in enumerate(folds, 1):

    print(f"\n{'='*55}")
    print(f"STARTING FOLD {fold_number}/5")
    print(f"{'='*55}")

    # Reproducible initialization for each fold
    fold_seed = SEED + fold_number
    random.seed(fold_seed)
    np.random.seed(fold_seed)
    torch.manual_seed(fold_seed)
    torch.cuda.manual_seed_all(fold_seed)

    # Create fold-specific datasets
    fold_train_records = [patient_records[i] for i in train_idx]
    fold_val_records = [patient_records[i] for i in val_idx]

    fold_train_dataset = AlzheimerDataset(fold_train_records)
    fold_val_dataset = AlzheimerDataset(fold_val_records)

    generator = torch.Generator()
    generator.manual_seed(fold_seed)

    fold_train_loader = DataLoader(
        fold_train_dataset,
        batch_size=BATCH_SIZE_CV,
        shuffle=True,
        num_workers=0,
        generator=generator
    )

    fold_val_loader = DataLoader(
        fold_val_dataset,
        batch_size=BATCH_SIZE_CV,
        shuffle=False,
        num_workers=0
    )

    # Calculate class weights using training patients only
    fold_labels = np.array([r["label"] for r in fold_train_records])
    class_counts = np.bincount(fold_labels, minlength=2)

    class_weights = len(fold_labels) / (
        2.0 * class_counts
    )

    criterion = nn.CrossEntropyLoss(
        weight=torch.tensor(
            class_weights,
            dtype=torch.float32,
            device=DEVICE
        )
    )

    print("Training patients:", len(train_idx))
    print("Validation patients:", len(val_idx))
    print("Class weights [CN, AD]:", class_weights.round(3))

    # Completely fresh model for this fold
    fold_model = AlzheimerNet(dropout_rate=0.5).to(DEVICE)

    fold_optimizer = optim.AdamW(
        fold_model.parameters(),
        lr=0.0001,
        weight_decay=0.0001
    )

    best_val_loss = float("inf")
    best_state = None
    best_epoch = 0
    patience_counter = 0

    # Training loop
    for epoch in range(MAX_EPOCHS_CV):

        train_loss, train_acc = train_one_epoch(
            fold_model,
            fold_train_loader,
            criterion,
            fold_optimizer
        )

        val_loss, val_acc = evaluate(
            fold_model,
            fold_val_loader,
            criterion
        )

        if val_loss < best_val_loss:

            best_val_loss = val_loss
            best_epoch = epoch + 1
            best_state = copy.deepcopy(fold_model.state_dict())
            patience_counter = 0

        else:
            patience_counter += 1

        if (epoch + 1) % 10 == 0:
            print(
                f"Epoch {epoch+1:03d} | "
                f"Train Acc: {train_acc*100:.2f}% | "
                f"Val Acc: {val_acc*100:.2f}% | "
                f"Val Loss: {val_loss:.4f}"
            )

        if patience_counter >= PATIENCE_CV:
            print("Early stopping at epoch:", epoch + 1)
            break

    # Restore best checkpoint
    fold_model.load_state_dict(best_state)

    # Evaluate best model on this fold's validation patients
    fold_model.eval()

    _, predictions, probabilities = get_predictions(fold_val_loader)

    actual = np.array([r["label"] for r in fold_val_records])

    accuracy = accuracy_score(actual, predictions)
    sensitivity = recall_score(
        actual, predictions, pos_label=1, zero_division=0
    )
    specificity = recall_score(
        actual, predictions, pos_label=0, zero_division=0
    )
    balanced_acc = balanced_accuracy_score(actual, predictions)
    f1 = f1_score(actual, predictions, zero_division=0)

    # Store predictions in original patient order
    for position, patient_index in enumerate(val_idx):
        oof_predictions[patient_index] = predictions[position]
        oof_probabilities[patient_index] = probabilities[position]

    fold_results.append({
        "fold": fold_number,
        "best_epoch": best_epoch,
        "accuracy": accuracy,
        "sensitivity": sensitivity,
        "specificity": specificity,
        "balanced_accuracy": balanced_acc,
        "f1": f1
    })

    print(f"\nFOLD {fold_number} RESULTS")
    print("Best epoch:", best_epoch)
    print(f"Accuracy: {accuracy*100:.2f}%")
    print(f"AD sensitivity: {sensitivity*100:.2f}%")
    print(f"CN specificity: {specificity*100:.2f}%")
    print(f"Balanced accuracy: {balanced_acc*100:.2f}%")
    print(f"F1-score: {f1:.4f}")

    del fold_model
    torch.cuda.empty_cache()


print("\n========== CROSS-VALIDATION COMPLETED ==========")

