class AlzheimerDataset(Dataset):

    def __init__(self, patient_records):
        self.records = patient_records

    def __len__(self):
        return len(self.records)

    def __getitem__(self, idx):

        record = self.records[idx]
        path = record["patient_path"]

        # Load MRI
        left_mri = np.load(
            os.path.join(path, "left_ht_mri.npy")
        )

        right_mri = np.load(
            os.path.join(path, "right_ht_mri.npy")
        )

        # Load PET
        left_pet = np.load(
            os.path.join(path, "left_ht_pet.npy")
        )

        right_pet = np.load(
            os.path.join(path, "right_ht_pet.npy")
        )

        # Stack hemispheres as channels
        mri = np.stack([left_mri, right_mri], axis=0)
        pet = np.stack([left_pet, right_pet], axis=0)

        # Convert to tensors
        mri = torch.tensor(mri, dtype=torch.float32)
        pet = torch.tensor(pet, dtype=torch.float32)

        label = torch.tensor(
            record["label"], dtype=torch.long
        )

        return mri, pet, label


