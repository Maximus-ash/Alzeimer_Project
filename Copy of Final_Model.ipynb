# Depthwise Separable 3D Convolution
class DSConv(nn.Module):

    def __init__(self, in_channels, out_channels):
        super().__init__()

        self.depthwise = nn.Conv3d(
            in_channels,
            in_channels,
            kernel_size=3,
            padding=1,
            groups=in_channels
        )

        self.pointwise = nn.Conv3d(
            in_channels,
            out_channels,
            kernel_size=1
        )

        self.bn = nn.BatchNorm3d(out_channels)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, x):
        x = self.depthwise(x)
        x = self.pointwise(x)
        x = self.bn(x)
        x = self.relu(x)
        return x


# Deep Feature Extractor
class DSFeatureExtractor(nn.Module):

    def __init__(self):
        super().__init__()

        self.ds1 = DSConv(2, 8)
        self.ds2 = DSConv(8, 8)
        self.ds3 = DSConv(8, 8)
        self.ds4 = DSConv(8, 8)

        self.pool = nn.MaxPool3d(2, 2)

    def forward(self, x):
        x = self.ds1(x)
        x = self.ds2(x)
        x = self.ds3(x)
        x = self.ds4(x)
        x = self.pool(x)
        return x


# Multiscale Cross-Modality Convolution
class MSCConv(nn.Module):

    def __init__(self, channels=8):
        super().__init__()

        self.depthwise = nn.Conv3d(
            channels * 2,
            channels * 2,
            kernel_size=3,
            padding=1,
            groups=channels * 2
        )

        self.pointwise = nn.Conv3d(
            channels * 2,
            channels,
            kernel_size=1
        )

        self.norm = nn.InstanceNorm3d(channels)
        self.activation = nn.LeakyReLU(0.1, inplace=True)

    def forward(self, x1, x2):
        x = torch.cat([x1, x2], dim=1)
        x = self.depthwise(x)
        x = self.pointwise(x)
        x = self.norm(x)
        x = self.activation(x)
        return x


# Multiscale Cross-Modality Stage
class MSCStage(nn.Module):

    def __init__(self):
        super().__init__()

        self.mri1 = MSCConv(8)
        self.mri2 = MSCConv(8)
        self.mri3 = MSCConv(8)

        self.pet1 = MSCConv(8)
        self.pet2 = MSCConv(8)
        self.pet3 = MSCConv(8)

    def forward(self, mri, pet):

        mri1 = self.mri1(mri, pet)
        pet1 = self.pet1(pet, mri)

        mri2 = self.mri2(mri1, pet1)
        pet2 = self.pet2(pet1, mri1)

        mri3 = self.mri3(mri2, pet2)
        pet3 = self.pet3(pet2, mri2)

        return mri3, pet3


# Shared-Weight Convolution
class SWConv(nn.Module):

    def __init__(self, channels=8):
        super().__init__()

        self.depthwise = nn.Conv3d(
            channels,
            channels,
            kernel_size=3,
            padding=1,
            groups=channels
        )

        self.pointwise = nn.Conv3d(
            channels,
            channels,
            kernel_size=1
        )

        self.bn = nn.BatchNorm3d(channels)
        self.activation = nn.LeakyReLU(0.1, inplace=True)

    def forward(self, x):
        x = self.depthwise(x)
        x = self.pointwise(x)
        x = self.bn(x)
        x = self.activation(x)
        return x


# Shared-Weight Stage
class SWStage(nn.Module):

    def __init__(self):
        super().__init__()

        self.sw1 = SWConv(8)
        self.sw2 = SWConv(8)
        self.sw3 = SWConv(8)

    def forward(self, mri, pet):

        mri = self.sw1(mri)
        pet = self.sw1(pet)

        mri = self.sw2(mri)
        pet = self.sw2(pet)

        mri = self.sw3(mri)
        pet = self.sw3(pet)

        return mri, pet


# Final Classifier with Dropout
class FinalClassifier(nn.Module):

    def __init__(self, dropout_rate=0.5):
        super().__init__()

        self.mri_pool = nn.AdaptiveAvgPool3d(1)
        self.pet_pool = nn.AdaptiveAvgPool3d(1)

        self.mri_fc = nn.Linear(8, 64)
        self.pet_fc = nn.Linear(8, 64)

        self.dropout = nn.Dropout(dropout_rate)

        self.fc1 = nn.Linear(128, 32)
        self.fc2 = nn.Linear(32, 2)

        self.relu = nn.ReLU()

    def forward(self, mri, pet):

        mri = self.mri_pool(mri).flatten(1)
        pet = self.pet_pool(pet).flatten(1)

        mri = self.relu(self.mri_fc(mri))
        pet = self.relu(self.pet_fc(pet))

        x = torch.cat([mri, pet], dim=1)

        x = self.dropout(x)
        x = self.relu(self.fc1(x))
        x = self.dropout(x)

        x = self.fc2(x)

        return x


# Complete Alzheimer Network
class AlzheimerNet(nn.Module):

    def __init__(self, dropout_rate=0.5):
        super().__init__()

        self.ds = DSFeatureExtractor()
        self.msc = MSCStage()
        self.sw = SWStage()

        self.classifier = FinalClassifier(dropout_rate)

    def forward(self, mri, pet):

        mri_feat = self.ds(mri)
        pet_feat = self.ds(pet)

        mri_feat, pet_feat = self.msc(mri_feat, pet_feat)

        mri_feat, pet_feat = self.sw(mri_feat, pet_feat)

        output = self.classifier(mri_feat, pet_feat)

        return output


