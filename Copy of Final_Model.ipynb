import torch
import numpy as np
import os

device = next(model.parameters()).device
model.eval()

ROOT_DIR = "/content/drive/MyDrive/Alzheimer_Project"
PROCESSED_DIR = os.path.join(ROOT_DIR, "Processed")

patients = {
    "012_S_0720": "AD",
    "018_S_0043": "CN"
}

def load_patient(patient_id, label):
    folder = os.path.join(PROCESSED_DIR, label, patient_id)

    mri = np.stack([
        np.load(os.path.join(folder, "left_ht_mri.npy")),
        np.load(os.path.join(folder, "right_ht_mri.npy"))
    ])

    pet = np.stack([
        np.load(os.path.join(folder, "left_ht_pet.npy")),
        np.load(os.path.join(folder, "right_ht_pet.npy"))
    ])

    mri = torch.tensor(mri, dtype=torch.float32).unsqueeze(0).to(device)
    pet = torch.tensor(pet, dtype=torch.float32).unsqueeze(0).to(device)

    return mri, pet

baseline_results = {}

with torch.no_grad():
    for patient_id, label in patients.items():
        mri, pet = load_patient(patient_id, label)
        logits = model(mri, pet)
        probabilities = torch.softmax(logits, dim=1)[0]

        predicted_class = int(probabilities.argmax())

        baseline_results[patient_id] = {
            "MRI": mri,
            "PET": pet,
            "probabilities": probabilities.cpu().numpy(),
            "predicted_class": predicted_class
        }

        print(f"\nPatient: {patient_id} | Actual: {label}")
        print("Probabilities [CN, AD]:", probabilities.cpu().numpy())
        print("Predicted:", "AD" if predicted_class == 1 else "CN")

import os
import numpy as np
import pandas as pd
import torch

GRADCAM_DIR = os.path.join(ROOT_DIR, "GradCAM_Results")
results = []

def mask_top_regions(volume, cam, fraction=0.10, random_mask=False):
    volume = volume.clone()
    cam = np.asarray(cam)

    flat = cam.reshape(-1)
    n_mask = max(1, int(len(flat) * fraction))

    if random_mask:
        rng = np.random.default_rng(42)
        indices = rng.choice(len(flat), n_mask, replace=False)
    else:
        indices = np.argpartition(flat, -n_mask)[-n_mask:]

    mask = torch.zeros(flat.shape, dtype=torch.bool, device=volume.device)
    mask[torch.as_tensor(indices, device=volume.device)] = True
    mask = mask.reshape(cam.shape)

    volume[0, :, mask] = 0
    return volume

model.eval()

for patient_id, label in patients.items():
    cam_path = os.path.join(
        GRADCAM_DIR, f"{patient_id}_GradCAM.npz"
    )
    cam_data = np.load(cam_path)

    original = baseline_results[patient_id]
    original_prob = original["probabilities"][1]

    for modality in ["MRI", "PET"]:
        cam_key = f"{modality}_CAM"
        cam = cam_data[cam_key]

        for condition in ["Original", "Top_10_percent", "Random_10_percent"]:
            mri = original["MRI"].clone()
            pet = original["PET"].clone()

            if condition != "Original":
                random_mask = condition == "Random_10_percent"

                if modality == "MRI":
                    mri = mask_top_regions(
                        mri, cam, random_mask=random_mask
                    )
                else:
                    pet = mask_top_regions(
                        pet, cam, random_mask=random_mask
                    )

            with torch.no_grad():
                logits = model(mri, pet)
                probs = torch.softmax(logits, dim=1)[0].cpu().numpy()

            results.append({
                "Patient": patient_id,
                "Actual": label,
                "Modality": modality,
                "Condition": condition,
                "CN_Probability": probs[0],
                "AD_Probability": probs[1],
                "AD_Probability_Change": probs[1] - original_prob
            })

df_faithfulness = pd.DataFrame(results)
display(df_faithfulness.round(4))

random_repeats = 10
random_results = []

for patient_id, label in patients.items():
    cam_data = np.load(
        os.path.join(GRADCAM_DIR, f"{patient_id}_GradCAM.npz")
    )

    original = baseline_results[patient_id]
    original_ad_prob = original["probabilities"][1]

    for modality in ["MRI", "PET"]:
        cam = cam_data[f"{modality}_CAM"]

        # Grad-CAM masking result
        mri = original["MRI"].clone()
        pet = original["PET"].clone()

        if modality == "MRI":
            mri = mask_top_regions(mri, cam)
        else:
            pet = mask_top_regions(pet, cam)

        with torch.no_grad():
            gradcam_prob = torch.softmax(model(mri, pet), dim=1)[0, 1].item()

        random_probs = []

        for repeat in range(random_repeats):
            mri = original["MRI"].clone()
            pet = original["PET"].clone()

            if modality == "MRI":
                mri = mask_top_regions(
                    mri, cam, random_mask=True
                )
            else:
                pet = mask_top_regions(
                    pet, cam, random_mask=True
                )

            # Note: use a different random seed for each repetition
            # in the next cell if the masks need to be independent.

            with torch.no_grad():
                prob = torch.softmax(
                    model(mri, pet), dim=1
                )[0, 1].item()

            random_probs.append(prob)

        random_changes = np.array(random_probs) - original_ad_prob

        random_results.append({
            "Patient": patient_id,
            "Modality": modality,
            "GradCAM_Absolute_Change": abs(gradcam_prob - original_ad_prob),
            "Random_Mean_Absolute_Change": np.mean(np.abs(random_changes)),
            "Random_Std": np.std(random_changes)
        })

display(pd.DataFrame(random_results).round(4))

import numpy as np
import pandas as pd
import torch
import os

def apply_random_mask(volume, fraction=0.10, seed=42):
    volume = volume.clone()
    rng = np.random.default_rng(seed)

    total = int(np.prod(volume.shape[2:]))
    n_mask = int(total * fraction)

    indices = rng.choice(total, n_mask, replace=False)

    mask = torch.zeros(total, dtype=torch.bool, device=volume.device)
    mask[torch.as_tensor(indices, device=volume.device)] = True
    mask = mask.reshape(volume.shape[2:])

    volume[0, :, mask] = 0
    return volume

corrected_results = []

for patient_id, label in patients.items():
    cam_data = np.load(
        os.path.join(GRADCAM_DIR, f"{patient_id}_GradCAM.npz")
    )

    original = baseline_results[patient_id]
    original_ad = original["probabilities"][1]

    for modality in ["MRI", "PET"]:
        cam = cam_data[f"{modality}_CAM"]

        # Grad-CAM masking
        mri = original["MRI"].clone()
        pet = original["PET"].clone()

        if modality == "MRI":
            mri = mask_top_regions(mri, cam)
        else:
            pet = mask_top_regions(pet, cam)

        with torch.no_grad():
            gradcam_ad = torch.softmax(
                model(mri, pet), dim=1
            )[0, 1].item()

        # Ten independent random masks
        random_ad_probs = []

        for seed in range(100, 110):
            mri = original["MRI"].clone()
            pet = original["PET"].clone()

            if modality == "MRI":
                mri = apply_random_mask(mri, seed=seed)
            else:
                pet = apply_random_mask(pet, seed=seed)

            with torch.no_grad():
                prob = torch.softmax(
                    model(mri, pet), dim=1
                )[0, 1].item()

            random_ad_probs.append(prob)

        random_changes = (
            np.array(random_ad_probs) - original_ad
        )

        corrected_results.append({
            "Patient": patient_id,
            "Modality": modality,
            "GradCAM_Absolute_Change": abs(gradcam_ad - original_ad),
            "Random_Mean_Absolute_Change": np.mean(
                np.abs(random_changes)
            ),
            "Random_Std": np.std(random_changes)
        })

df_corrected = pd.DataFrame(corrected_results)
display(df_corrected.round(5))

