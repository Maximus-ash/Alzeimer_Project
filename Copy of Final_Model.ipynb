# ============================================
# CELL 20: GRAD-CAM CLASS
# ============================================

class GradCAM3D:

    def __init__(self, model, target_layer):

        self.model = model
        self.records = []

        self.hook = target_layer.register_forward_hook(
            self.save_activation
        )

    def save_activation(self, module, inputs, output):

        index = len(self.records)

        self.records.append({
            "activation": output.detach(),
            "gradient": None
        })

        if torch.is_grad_enabled() and output.requires_grad:

            output.register_hook(
                lambda grad, i=index:
                self.records[i].update({
                    "gradient": grad.detach()
                })
            )

    def generate(self, mri, pet, target_class=None):

        self.records = []

        self.model.eval()
        self.model.zero_grad(set_to_none=True)

        output = self.model(mri, pet)

        if target_class is None:
            target_class = output.argmax(dim=1).item()

        score = output[:, target_class].sum()
        score.backward()

        if len(self.records) != 2:
            raise RuntimeError(
                f"Expected 2 modality activations, "
                f"received {len(self.records)}"
            )

        cams = []

        for record in self.records:

            activation = record["activation"]
            gradient = record["gradient"]

            if gradient is None:
                raise RuntimeError("Gradient was not captured.")

            weights = gradient.mean(
                dim=(2, 3, 4),
                keepdim=True
            )

            cam = (weights * activation).sum(dim=1)
            cam = F.relu(cam)

            cam_min = cam.amin(dim=(1, 2, 3), keepdim=True)
            cam_max = cam.amax(dim=(1, 2, 3), keepdim=True)

            cam = (cam - cam_min) / (
                cam_max - cam_min + 1e-8
            )

            cams.append(cam.detach().cpu().numpy()[0])

        return cams[0], cams[1], target_class, output.detach()

    def remove_hooks(self):
        self.hook.remove()


# Create Grad-CAM object
gradcam = GradCAM3D(
    model,
    model.ds.ds4
)

